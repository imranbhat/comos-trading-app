{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "OrderCommand",
  "description": "Command to create a new order",
  "required": ["orderId", "symbol", "side", "quantity", "price", "orderType"],
  "properties": {
    "orderId": {
      "type": "string",
      "description": "Unique order identifier"
    },
    "symbol": {
      "type": "string",
      "description": "Trading symbol (e.g., AAPL, MSFT)"
    },
    "side": {
      "type": "string",
      "enum": ["BUY", "SELL"],
      "description": "Order side"
    },
    "quantity": {
      "type": "number",
      "minimum": 1,
      "description": "Order quantity"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "description": "Order price"
    },
    "orderType": {
      "type": "string",
      "enum": ["LIMIT", "MARKET"],
      "description": "Order type"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Command timestamp"
    }
  }
}

